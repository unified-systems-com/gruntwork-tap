{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "gruntwork-tap",
      "extra-files": [
        {
          "type": "generic",
          "path": "tap_plugin/gruntwork/tap-plugin.toml"
        },
        {
          "type": "json",
          "path": "tap_plugin/gruntwork/boot/ci.boot.json",
          "jsonpath": "$.install.plugins[?(@.slug=='gruntwork')].source.rev"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
